{
  "name": "@sos/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json -w",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "vitest": "3.2.7",
    "typescript": "5.9.3",
    "eslint": "9.39.5",
    "typescript-eslint": "^8.46.0",
    "@eslint/js": "^9.39.0"
  }
}
