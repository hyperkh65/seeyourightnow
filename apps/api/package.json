{
  "name": "@sos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "openapi": "tsx --env-file-if-exists=../../.env src/scripts/openapi.ts",
    "db:reset": "tsx --env-file-if-exists=../../.env src/db/reset.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@node-rs/argon2": "2.2.1",
    "@simplewebauthn/server": "13.3.3",
    "@sos/core": "workspace:*",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.1",
    "fastify-type-provider-zod": "4.0.2",
    "file-type": "19.6.0",
    "handlebars": "4.7.9",
    "ioredis": "^5.8.2",
    "nodemailer": "^7.0.10",
    "otplib": "12.0.1",
    "pg": "8.23.0",
    "pino": "^9.14.0",
    "playwright-core": "1.56.1",
    "sharp": "^0.34.5",
    "ws": "^8.18.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "3.2.7"
  }
}