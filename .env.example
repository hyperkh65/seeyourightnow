# ─── Sourcing OS environment (copy to .env) ───────────────────────────────
# Never commit real secrets. In production use a secret manager.
NODE_ENV=development
# DEV_MODE enables clearly-labelled mock supplier data. MUST be false in production.
DEV_MODE=true
PORT=4000
LOG_LEVEL=info

# Database roles (see infra/postgres/01-roles.sh). App role has RLS enforced.
DATABASE_URL=postgres://sos_app:sos_app@localhost:5432/sourcing_os
DATABASE_SYSTEM_URL=postgres://sos_system:sos_system@localhost:5432/sourcing_os
DATABASE_OWNER_URL=postgres://sos_owner:sos_owner@localhost:5432/sourcing_os
REDIS_URL=redis://localhost:6379

# Tenant routing: <slug>.<PLATFORM_BASE_DOMAIN>. *.localhost resolves to 127.0.0.1 in browsers.
PLATFORM_BASE_DOMAIN=localhost
PLATFORM_ADMIN_HOST=platform.localhost
DEFAULT_TENANT_SLUG=demo
PUBLIC_WEB_URL=http://localhost:3000
TRUST_PROXY=true

# Security keys — generate with: openssl rand -base64 32
SECRETS_MASTER_KEY=
APP_SIGNING_KEY=
SECRETS_BACKEND=BUILTIN
# VAULT_ADDR= / VAULT_TOKEN= / INFISICAL_API_URL= / INFISICAL_TOKEN= / INFISICAL_PROJECT_ID=
COOKIE_SECURE=false

# Storage: local (dev) or s3 (MinIO / AWS S3 / R2 / NAS S3 gateway)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=sourcing-os
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_MB=20
# CLAMAV_HOST=localhost

# PDF rendering: Gotenberg if set, otherwise bundled Chromium
# GOTENBERG_URL=http://localhost:3001
CHROMIUM_PATH=

# System default SMTP (tenants can configure their own in Admin → API 연결)
# SMTP_HOST=localhost
# SMTP_PORT=1025
EMAIL_FROM_DEFAULT=no-reply@localhost

# Background worker inside the API process (dev convenience). Use the separate worker in production.
RUN_WORKER_IN_PROCESS=true
WORKER_CONCURRENCY=4

# Web app → API
API_INTERNAL_URL=http://localhost:4000
SEED_PASSWORD=Demo-Pass-2026!
